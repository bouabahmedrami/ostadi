rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════
    // 🔐 ADMIN UNIQUE — verrouillé côté serveur
    // Personne ne peut se donner ce rôle : il est en dur ici.
    // ═══════════════════════════════════════════════════════
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == '4bnssIV8FlS80SzaX6ylwc9Fbg92';
    }

    // ── Helpers ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isTeacher() {
      return isAuth() && getUserRole() == 'teacher';
    }
    function isStudent() {
      return isAuth() && getUserRole() == 'student';
    }

    // ── Users ─────────────────────────────────────────────
    match /users/{userId} {
      // Lecture ouverte.
      //
      // La condition précédente — `resource.data.role == 'teacher' || isAuth()` —
      // échouait de façon imprévisible : lors d'une lecture par identifiant,
      // `resource` peut ne pas être disponible au moment de l'évaluation,
      // et la règle refusait alors même un utilisateur authentifié lisant
      // son propre profil. Résultat : profil vide, menu incomplet.
      //
      // Ces documents ne contiennent que des informations destinées à être
      // affichées publiquement (nom, wilaya, matières, note, photo).
      // L'écriture reste strictement contrôlée ci-dessous.
      allow read: if true;
      allow create: if isOwner(userId);
      // ⚠️ L'utilisateur NE PEUT PAS modifier son propre rôle
      allow update: if (isOwner(userId)
                        && request.resource.data.role == resource.data.role)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Classes ───────────────────────────────────────────
    match /classes/{classeId} {
      // Lecture publique : un parent doit pouvoir parcourir les cours
      // AVANT de créer un compte. Ces documents ne contiennent que des
      // informations destinées à être publiques (titre, prix, horaire,
      // nom du professeur, numéro WhatsApp qu'il a choisi d'exposer).
      allow read: if true;
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.price >= 0
        && request.resource.data.title.size() > 0;
      allow update: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isStudent() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['enrolledCount', 'attendanceCount']))
        // Compteur de vues : modifiable par n'importe qui, mais lui seul.
        // Un visiteur non connecté doit pouvoir être compté.
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['viewCount']);
      allow delete: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // ── Enrollments ───────────────────────────────────────
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (isAuth() && (
        isTeacher() || resource.data.studentId == request.auth.uid
      ));
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attended']))
        || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }

    // ── Enrollment Requests ───────────────────────────────
    match /enrollmentRequests/{requestId} {
      allow read: if isAdmin() || (isAuth() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      ));
      allow create: if isAuth()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (isAuth() && resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin() || isTeacher();
    }

    // ── Ratings ───────────────────────────────────────────
    match /ratings/{ratingId} {
      // Les avis sont affichés sur les profils publics des professeurs
      allow read: if true;
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;
      allow update: if isAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Messages (chat) ───────────────────────────────────
    match /messages/{messageId} {
      allow read: if isAdmin() || isAuth();
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    match /chatRooms/{roomId} {
      allow read, write: if isAuth();
    }

    // ── Notifications ─────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // 🔒 DONNÉES SENSIBLES — admin + propriétaire uniquement
    // ═══════════════════════════════════════════════════════

    // ── Vérifications (diplômes, pièces d'identité) ───────
    match /verifications/{verifId} {
      // Seul l'admin voit TOUS les dossiers.
      // Le prof ne voit que le sien.
      allow read: if isAdmin()
        || (isAuth() && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;
      // Seul l'admin peut approuver / refuser
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Abonnements (données financières) ─────────────────
    match /subscriptions/{subId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Seul l'admin active un abonnement
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Enregistrements vidéo ─────────────────────────────
    match /recordings/{recId} {
      allow read: if isAuth();
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // ── Règlements de commission ──────────────────────────
    // Historique des sommes versées par les professeurs à Ostadi.
    // Sans cette collection, impossible de savoir qui a payé quoi
    // ni de calculer les retards.
    match /commissionPayments/{paymentId} {
      // Le professeur consulte ses propres règlements (pour son bilan),
      // l'admin voit tout
      allow read: if isAdmin()
        || (isAuth() && resource.data.teacherId == request.auth.uid);
      // Seul l'admin enregistre un paiement : c'est lui qui l'a reçu
      allow create, update, delete: if isAdmin();
    }

    // ── Historique des rappels de paiement ────────────────
    // Trace des relances envoyées, pour éviter de solliciter
    // deux fois le même professeur dans la semaine.
    match /paymentReminders/{reminderId} {
      allow read, write: if isAdmin();
    }

    // ── Marqueurs de rappel ───────────────────────────────
    // Évitent d'envoyer deux fois le même rappel de cours.
    match /reminderMarkers/{markerId} {
      allow read, create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // ── Supports de cours ─────────────────────────────────
    // Le titre est visible par les connectés ; le fichier lui-même
    // est protégé par les règles Storage.
    match /materials/{materialId} {
      allow read: if isAuth();
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isAuth() && resource.data.teacherId == request.auth.uid);
    }

    // ── Vues des cours ────────────────────────────────────
    // Un document par visiteur et par jour, pour ne compter
    // qu'une seule fois celui qui recharge la page.
    match /classeViews/{viewId} {
      allow read: if isAuth();
      // Ouvert : les visiteurs non connectés parcourent aussi les cours
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ── Collection admin privée (config, logs) ────────────
    match /adminData/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
